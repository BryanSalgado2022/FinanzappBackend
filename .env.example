# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by the API.
# When running locally (outside Docker) against `docker compose up db`:
DATABASE_URL=postgresql+psycopg://finanzapp:finanzapp@localhost:5433/finanzapp

# Google OAuth client id (from Google Cloud Console) used to verify ID tokens
# sent by the frontend after Google Sign-In.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Gemini API key (from Google AI Studio) used by the AI chat agent
# (POST /agent/chat) to interpret natural-language messages. Optional - the
# rest of the app works without it, but the chat endpoint returns an error
# until it's set.
GEMINI_API_KEY=

# Secret used to sign this API's own JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Comma-separated list of origins allowed to call this API from a browser
# (the frontend's dev server and, later, its production URL).
CORS_ORIGINS=http://localhost:5173

# When true, exposes POST /auth/dev-login, which logs in as a fixed local
# user with NO Google verification at all. Local development convenience
# only - leave false/unset everywhere except your own machine.
DEV_MODE=false
